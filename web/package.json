{
  "name": "mneme-web",
  "private": true,
  "version": "8.8.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build --emptyOutDir=false",
    "sync:dist": "node scripts/sync-dist.mjs",
    "sync:deploy": "node ../scripts/sync-deploy.mjs",
    "release": "npm run build && npm run sync:dist && npm run sync:deploy",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "preview": "vite preview",
    "test:privacy": "node --experimental-sqlite ../ingest/test-privacy.mjs",
    "test:api": "node --experimental-sqlite ../ingest/test-api-privacy.mjs",
    "test:silk": "node scripts/test-silk.mjs",
    "test:strict": "node --experimental-sqlite ../ingest/test-strict.mjs",
    "lh:field": "node scripts/lighthouse-field.mjs",
    "smoke": "node --input-type=module -e \"console.log('公开仓不含带口令的浏览器验收稿；本地请对运行中的实例做点击复核。')\""
  },
  "dependencies": {
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@fontsource/noto-serif-sc": "^5.3.0",
    "animejs": "^4.5.0",
    "d3-force": "^3.0.0",
    "html2canvas": "^1.4.1",
    "markdown-it": "^15.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/markdown-it": "^14.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
